# v7.7 环境配置
# 复制为 .env 并填入真实值: cp .env.example .env

# === 资金与模式 ===
INITIAL_CAPITAL=500.0
PAPER_TRADING=true
DRY_RUN=false

# === 杠杆 ===
MAX_LEVERAGE=20

# === AI 辅助 (DeepSeek) ===
AI_ENABLED=true
AI_API_KEY=sk-your-deepseek-api-key-here
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat

# === WxPusher 微信通知 ===
WXPUSHER_APP_TOKEN=AT-your-token-here
WXPUSHER_UIDS=["UID_xxx"]

# === Hyperliquid API (实盘时填写) ===
HYPERLIQUID_WALLET=
HYPERLIQUID_PRIVATE_KEY=
